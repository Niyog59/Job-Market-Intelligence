# Settings for deploy/docker-compose.yml. On the server, copy this file to deploy/.env,
# replace every placeholder, and make it readable only by you (chmod 600 .env).
# The copy holds real passwords: it is ignored by Git and must never be committed.
#
# Passwords: letters and digits only (a "$" would be read as a variable). Make each one
# with:  openssl rand -hex 24

# The site's domain (RUNBOOK C), for example yourproduct.dev
SITE_DOMAIN=CHANGE_ME.dev

# Image tag; use the Git commit you deployed (git rev-parse --short HEAD) so a rollback can
# go back to the previous image.
APP_VERSION=local

# PostgreSQL superuser, used only by the database container.
POSTGRES_PASSWORD=CHANGE_ME

# The application database and its three logins (created on the first start).
DB_NAME=Job_Market
DB_USER=jobmarket
DB_PASSWORD=CHANGE_ME
ANALYTICS_DB_PASSWORD=CHANGE_ME
PRIVATE_DB_PASSWORD=CHANGE_ME

# Airflow (scheduling). Its own database login, plus two secrets:
#   AIRFLOW_DB_PASSWORD   openssl rand -hex 24
#   AIRFLOW_JWT_SECRET    openssl rand -hex 32
#   AIRFLOW_FERNET_KEY    python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_DB_PASSWORD=CHANGE_ME
AIRFLOW_JWT_SECRET=CHANGE_ME
AIRFLOW_FERNET_KEY=CHANGE_ME_FERNET

# Private S3 bucket for raw responses and backups. No access keys: the EC2 instance role
# supplies credentials.
JOBMARKET_S3_BUCKET=CHANGE_ME
AWS_REGION=us-east-2

# Website processes (see SIZING.md).
GUNICORN_CMD_ARGS=--workers 1 --threads 4

# Email: daily summary, alerts, and recovery notices (docs/OPERATIONS.md, "Pipeline steps,
# alerts, and the daily summary"). Gmail with an app password; the app password is a secret.
JOBMARKET_SMTP_HOST=smtp.gmail.com
JOBMARKET_SMTP_PORT=587
JOBMARKET_SMTP_USER=CHANGE_ME@gmail.com
JOBMARKET_SMTP_PASSWORD=CHANGE_ME
JOBMARKET_ALERT_FROM=CHANGE_ME@gmail.com
JOBMARKET_ALERT_TO=CHANGE_ME@gmail.com

# Optional heartbeat URL (for example a healthchecks.io check), requested after each daily
# summary. It identifies your check: treat it as a secret.
# JOBMARKET_HEARTBEAT_URL=

# Google Sheet behind the Tableau Public dashboards (RUNBOOK section T). Leave unset until
# the Sheet exists; until then the sync step is skipped. The key file goes in
# deploy/secrets/ (git-ignored) and is read inside the containers at /app/secrets/.
# JOBMARKET_SHEETS_ID=
# JOBMARKET_SHEETS_KEY_FILE=/app/secrets/google-sheets.json

# The published Tableau Public workbook shown on the Market insights page (RUNBOOK T5): its
# name as it appears in the dashboard addresses (https://public.tableau.com/views/NAME/...),
# and optionally your Tableau Public profile address. Until set, the page shows the headline
# numbers and says the dashboards are on their way.
# JOBMARKET_TABLEAU_WORKBOOK=
# JOBMARKET_TABLEAU_PROFILE=https://public.tableau.com/app/profile/YOUR-PROFILE

# Collection hours, Chicago time, comma-separated (default 8,12,21). One hour must be 17 or
# later: that run also backs up and sends the daily summary. Restart Airflow after a change.
# JOBMARKET_COLLECTION_HOURS=8,12,21

# Requirement extraction (Gemini free tier), for the hourly batch and the extraction
# worker. Leave unset until you decide to run extraction on the server; see
# docs/EXTRACTION.md. JOBMARKET_AI_NEW_RESERVE is how many of the day's requests the backlog
# may never use (default 200).
# GEMINI_API_KEY=
# JOBMARKET_AI_MODEL=
# JOBMARKET_AI_THINKING=
# JOBMARKET_AI_RPM=
# JOBMARKET_AI_DAILY_LIMIT=
# JOBMARKET_AI_TPM=
# JOBMARKET_AI_NEW_RESERVE=

# Optional services to start with `docker compose up -d`. "worker" starts the extraction
# worker (RUNBOOK section W); remove it to go back to the hourly batch.
# COMPOSE_PROFILES=worker
