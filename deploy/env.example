# Settings for deploy/docker-compose.yml. On the server, copy this file to deploy/.env,
# replace every placeholder, and make it readable only by you (chmod 600 .env).
# The copy holds real passwords: it is ignored by Git and must never be committed.
#
# Passwords: letters and digits only (a "$" would be read as a variable). Make each one
# with:  openssl rand -hex 24

# Your DuckDNS name, for example jobsdemo.duckdns.org
SITE_DOMAIN=CHANGE_ME.duckdns.org

# Image tag; use the Git commit you deployed (git rev-parse --short HEAD) so a rollback can
# go back to the previous image.
APP_VERSION=local

# PostgreSQL superuser, used only by the database container.
POSTGRES_PASSWORD=CHANGE_ME

# The application database and its three logins (created on the first start).
DB_NAME=Job_Market
DB_USER=jobmarket
DB_PASSWORD=CHANGE_ME
ANALYTICS_DB_PASSWORD=CHANGE_ME
PRIVATE_DB_PASSWORD=CHANGE_ME

# Private S3 bucket for raw responses and backups. No access keys: the EC2 instance role
# supplies credentials.
JOBMARKET_S3_BUCKET=CHANGE_ME
AWS_REGION=us-east-2

# Website processes (see SIZING.md).
GUNICORN_CMD_ARGS=--workers 1 --threads 4

# Requirement extraction (Gemini free tier), for `jobmarket extract run`. Leave unset until
# you decide to run extraction on the server; see the main README.
# GEMINI_API_KEY=
# JOBMARKET_AI_MODEL=
# JOBMARKET_AI_THINKING=
# JOBMARKET_AI_RPM=
# JOBMARKET_AI_DAILY_LIMIT=
# JOBMARKET_AI_TPM=
