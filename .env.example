# Copy this file to .env and fill in your own values.
# .env is ignored by Git. Never put real passwords in this example file.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_market
DB_USER=
DB_PASSWORD=

# Optional (see README):
# JOBMARKET_RAW_DIR=data/raw
# JOBMARKET_REQUEST_INTERVAL=1.0
# Alert email delivery. Leave unset to keep alerts in the outbox only.
# JOBMARKET_SMTP_HOST=
# JOBMARKET_SMTP_PORT=587
# JOBMARKET_SMTP_USER=
# JOBMARKET_SMTP_PASSWORD=
# JOBMARKET_ALERT_FROM=
# JOBMARKET_ALERT_TO=

# Requirement extraction (Gemini, free tier). Never commit the key.
# GEMINI_API_KEY=
# JOBMARKET_AI_MODEL=gemini-3.5-flash-lite
# JOBMARKET_AI_THINKING=minimal
# Your account's free-tier limits for that model, from Google AI Studio (required to run):
# JOBMARKET_AI_RPM=
# JOBMARKET_AI_DAILY_LIMIT=
# JOBMARKET_AI_TPM=
# JOBMARKET_AI_TIMEOUT_SECONDS=120

# dbt analytics (read-only login; see README "Analytics")
# ANALYTICS_DB_USER=jobmarket_analytics
# ANALYTICS_DB_PASSWORD=
